<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('components/layout') -%>
  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>
  <link rel="stylesheet" href="/stylings/dashboard.css">
  <link rel="stylesheet" href="/stylings/components/header.css">
  <link rel="stylesheet" href="/stylings/components/footer.css">
  <link rel="stylesheet" href="/stylings/components/effects/loader.css">
  <link rel="stylesheet" href="/stylings/__global_variables__.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Jockey+One&display=swap" rel="stylesheet">
  <!--function Import-->
  <script src="/js/effects/loader.js" defer></script>
  <title>Dashboard</title>
</head>

<body>
  <div class="container">
    <%- include('components/effects/loader') -%>
    <%- include('components/header') -%>
    <main>
      <div class="addiv">
        <p>Ad space here</p>
      </div>
      <h2 class="pageH2"><i class='bx bx-dashboard-alt'></i>Dashboard <span class="header-tag"><i class="bx bx-box"></i>TOOLBOX</span></h2>
      <div class="toolboxes-container">
        <div class="toolboxes-grid-container">
          <div class="tool">
            <div class="tool-header">
              <i class='bx bx-code'></i>
              <h3>Encoder</h3>
            </div>
            <a href="/tools/encoder"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
                <span id="button-text">Start Here!</span>
              </button></a>
          </div>
          <div class="tool">
            <div class="tool-header">
              <i class='bx bx-draw-behind'></i>
              <h3>Decoder</h3>
            </div>
            <a href="tools/decoder"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
                <span id="button-text">Start Here!</span>
              </button></a>
          </div>
          <div class="tool">
            <div class="tool-header">
              <i class='bx bx-shield-quarter'></i>
              <h3>Encrypter</h3>
            </div>
            <a href="tools/encrypter"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
                <span id="button-text">Start Here!</span>
              </button></a>
          </div>
          <div class="tool">
            <div class="tool-header">
              <i class='bx bx-lock'></i>
              <h3>Decrypter</h3>
            </div>
            <a href="tools/decrypter"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
                <span id="button-text">Start Here!</span>
              </button></a>
          </div>
          <div class="tool">
            <div class="tool-header">
              <i class='bx bx-alert-triangle'></i>
              <h3>Error <br />Debugging</h3>
            </div>
            <a href="/tools/errorDebugger"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
                <span id="button-text">Start Here!</span>
              </button></a>
          </div>
          <div class="tool">
            <div class="tool-header">
              <i class='bx bx-palette'></i>
              <h3>Gradiant <br />Generator</h3>
            </div>
            <a href="/tools/gradiantGenerator"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
                <span id="button-text">Start Here!</span>
              </button></a>
          </div>
        </div>
      </div>
      <div class="addiv">
        <p>Ad space here</p>
      </div>
      <%- include('components/footer') -%>
    </main>
  </div>
</body>

</html>