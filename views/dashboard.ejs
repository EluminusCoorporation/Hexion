<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>
  <link rel="website icon" href="/global/logo.png">
  <link rel="stylesheet" href="/stylings/dashboard.css">
  <link rel="stylesheet" href="/stylings/components/header.css">
  <link rel="stylesheet" href="/stylings/components/footer.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
  <title>Dashboard</title>
</head>

<body>
  <div class="container">
    <div id="preloader">
      <svg class="circular" viewBox="25 25 50 50">
        <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="3.5" stroke-miterlimit="10"></circle>
      </svg>
    </div>
    <%- include('components/header') -%>
    <div class="addiv ad2">
      <p class="adp">Ad space here</p>
    </div>
    <h2 class="homeH2"><i class='bx bx-cube-alt homeI'></i>Home (Toolboxes)</h2>
    <div class="toolboxes-container">
      <div class="tool1 tool">
        <div class="top-right design">
        </div>
        <div class="i-h3">
          <i class='bx bx-expand-horizontal'></i>
          <h3>Encoding</h3>
        </div>
        <div class="bottom-left design">
        </div>
        <a href="/tools/encoding"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
            <tag id="button-text">Start Here!</tag>
          </button></a>
      </div>
      <div class="tool2 tool">
        <div class="top-right design">
        </div>
        <div class="i-h3">
          <i class='bx bx-collapse-horizontal'></i>
          <h3>Decoding</h3>
        </div>
        <div class="bottom-left design">
        </div>
        <a href="tools/decoding"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
            <tag id="button-text">Start Here!</tag>
          </button></a>
      </div>
      <div class="tool3 tool">
        <div class="top-right design">
        </div>
        <div class="i-h3">
          <i class='bx bx-shield-quarter'></i>
          <h3>Encrypting</h3>
        </div>
        <div class="bottom-left design">
        </div>
        <a href="tools/encrypting"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
            <tag id="button-text">Start Here!</tag>
          </button></a>
      </div>
      <div class="tool4 tool">
        <div class="top-right design">
        </div>
        <div class="i-h3">
          <i class='bx bx-lock'></i>
          <h3>Decrypting</h3>
        </div>
        <div class="bottom-left design">
        </div>
        <a href="tools/decrypting"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
            <tag id="button-text">Start Here!</tag>
          </button></a>
      </div>
      <div class="tool5 tool">
        <div class="top-right design">
        </div>
        <div class="i-h3">
          <i class='bx bx-error'></i>
          <h3>Error <br />Debugging</h3>
        </div>
        <div class="bottom-left design">
        </div>
        <a href="/tools/errorDebugger"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
            <tag id="button-text">Start Here!</tag>
          </button></a>
      </div>
      <div class="tool6 tool">
        <div class="top-right design">
        </div>
        <div class="i-h3">
          <i class='bx bx-palette'></i>
          <h3>Color Code <br />Generator</h3>
        </div>
        <div class="bottom-left design">
        </div>
        <a href="/tools/colorCodeGenerator"><button id="button-launch" class="tool-button"><i class='bx bxs-rocket button-icon' id="button-icon"></i>
            <tag id="button-text">Start Here!</tag>
          </button></a>
      </div>
    </div>
    <div class="addiv ad3">
      <p class="adp">Ad space here</p>
    </div>
    <%- include('components/footer') -%>
  </div>
  <!--Scripts-->
  <script src="/js/effects/loading.js"></script>
</body>

</html>