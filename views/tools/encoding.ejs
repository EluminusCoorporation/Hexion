<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>
  <link rel="website icon" href="/global/logo.png">
  <link rel="stylesheet" href="/stylings/tools/encoding.css">
  <link rel="stylesheet" href="/stylings/components/header.css">
  <link rel="stylesheet" href="/stylings/components/footer.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
  <title>Encoding(Tool)</title>
</head>

<body>
  <div class="container">
    <div id="preloader">
      <svg class="circular" viewBox="25 25 50 50">
        <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="3.5" stroke-miterlimit="10"></circle>
      </svg>
    </div>
    <%- include('../components/header') -%>
    <div class="addiv ad1">
      <p class="adp">Ad space here</p>
    </div>
    <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i><p>Back to dashboard</p></a>
    <h2 class="homeH2"><i class='bx bx-cube-alt homeI'></i>Encoding(Tool)</h2>
    <div id="errorDiv">
      <i class='bx bx-error'></i>
      <div class="linefordiv"></div>
      <p id="errorText"></p>
    </div>
    <div class="dropdown-container" id="dropDownMenu">
      <div class="head-i">
        <h3 class="dropdown-text" id="dropdown-text">Format Selector</h3>
          <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
      </div>
      <div class="dropdown-content" id="dropDownContent">
        <p class="select-item">UTF-8 <span class="recommended" id="spanR">recommended</span></p>
        <p class="select-item">UTF-16</p>
        <p class="select-item">UTF-32</p>
        <p class="select-item">Base 64</p>
        <p class="select-item">ASCII</p>
        <p class="select-item">EXTENDED ASCII</p>
        <p class="select-item">Binary</p>
        <p class="select-item">Shift Jis</p>
        <p class="select-item">ISO 8859-1</p>
        <p class="select-item">Morse Code</p>
      </div>
    </div>
    <input type="text" name="textToConvert" id="ttc" placeholder="Text" class="ttc" maxlength="500" />
    <div class="flexbox-results" id="resultsDiv">
      <div class="results-div">
        <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Results"></textarea>
        <i class='bx bx-copy' id="tcopy"></i>
      </div>
    </div>
    <div class="results-btn-div">
      <button class="results-button" id="results-btn">Encode!</button>
    </div>
    <%- include('../components/footer') -%>
  </div>
  <script src="/js/effects/loading.js"></script>
  <script src="/js/effects/drop-down-menu.js"></script>
  <script src="/js/tools/encoding.js" type="module"></script>
</body>

</html>