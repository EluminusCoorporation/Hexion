<%- include('../components/header', {
  color: 'lawngreen',
  icon: 'bx bx-draw-behind',
  backButton: true,
  tag: 'TOOL'
}) -%>

      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Format Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <li class="dropdown-item">UTF-8</li>
          <li class="dropdown-item">UTF-16</li>
          <li class="dropdown-item">UTF-32</li>
          <li class="dropdown-item">Base 64</li>
          <li class="dropdown-item">ASCII</li>
          <li class="dropdown-item">EXTENDED ASCII</li>
          <li class="dropdown-item">Binary</li>
          <li class="dropdown-item">Shift Jis</li>
          <li class="dropdown-item">ISO 8859-1</li>
          <li class="dropdown-item">Morse Code</li>
        </ul>
      </div>
      <input type="text" name="textToConvert" id="inputContainer" placeholder="Text" class="input-container" maxlength="500" />
      <div class="flexbox-results" id="resultsContainer">
        <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Results"></textarea>
        <i class='bx bx-copy copy-button' id="copy-icon"></i>
      </div>
      <div class="results-button-container">
        <button class="results-button" id="results-btn">Decode!</button>
      </div>
      <%- include('../components/footer') -%>