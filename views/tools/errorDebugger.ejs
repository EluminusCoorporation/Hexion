<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('../components/layout') -%>
  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>
  <link rel="stylesheet" href="/stylings/tools/errorDebugger.css">
  <link rel="stylesheet" href="/stylings/components/header.css">
  <link rel="stylesheet" href="/stylings/components/footer.css">
  <link rel="stylesheet" href="/stylings/components/effects/loader.css">
  <link rel="stylesheet" href="/stylings/__global_variables__.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
  <!--function Import-->
  <script src="/js/effects/loader.js" defer></script>
  <script src="/js/tools/errorDebugger.js" type="module" defer></script>
  <!--Icon Import-->
  <script src="https://kit.fontawesome.com/57901f661d.js" crossorigin="anonymous" defer></script>
  <title>Error Debugger</title>
</head>

<body>
  <div class="container" id="container">
    <%- include('../components/effects/loader') -%>
    <%- include('../components/header') -%>
    <main>
      <div class="addiv">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h2 class="pageH2"><i class='bx bx-alert-triangle'></i>ErrorDebugger<span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h2>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="head-i">
          <h3 class="dropdown-text" id="dropdown-text"><i class="bx bx-refresh-cw langIcon"></i>Auto</h3>
          <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li>
              <p class="select-item" id="auto" data-ext="auto">
                <i class="bx bx-refresh-cw langIcon"></i>
                Auto
                <span class="recommended" id="spanR">recommended</span>
              </p>
            </li>
            <li><p class="select-item" data-ext="html" id="html">
              <i class="bxl bx-html5 langIcon"></i>
              Html
            </p></li>
            <li><p class="select-item" id="css" data-ext="css">
              <i class="bxl bx-css3 langIcon"></i>
              Css
            </p></li>
            <li><p class="select-item" id="javascript" data-ext="js">
              <i class="bxl bx-javascript langIcon"></i>
              Java Script
            </p></li>
            <li><p class="select-item" id="python" data-ext="py">
              <i class="bxl bx-python langIcon"></i>Python
            </p></li>
          </div>
        </ul>
      </div>
      
      <div class="buttonWrapper">
        <div class="buttonIndicator" id="btnIndicator"></div>
        <button class="dualbtn dbtn1" id="fileMode"><i class="bx bx-file-detail"></i>File mode</button>
        <button class="dualbtn dbtn2" id="textMode"><i class="bx bx-edit-alt"></i>Text mode</button>
      </div>
      <div class="switcherContainer">
        <div class="uploadWrapper selected" id="uploadWrapper">
          <input type="file" id="fileUploader" class="file-upload-input">
          <label for="fileUploader" class="file-upload-button" id="uploadZone">
            <i class='fa-solid fa-upload dragicon' id="fileIcon"></i>
            <p id="fileName" class="file-name">Upload File</p>
          </label>
        </div>
        <textarea name="textToConvert" id="textmodetxt" placeholder="Code" class="ttc" maxlength="500"></textarea>
      </div>
      
      <div class="flexbox-results" id="resultsDiv">
        <div class="results-div">
          <div class="ball-container">
            <div class="redball ball"></div>
            <div class="yellowball ball"></div>
            <div class="greenball ball"></div>
          </div>
          <div class="textarea-div">
            <textarea class="numbersPH" cols="5" readonly></textarea>
            <textarea class="codePH" maxlength="500" placeholder="Results" id="results"></textarea>
            <i class='bx bx-copy' id="copy-icon"></i>
          </div>
        </div>
        <div class="error-switch">
          <i class='bx bx-arrow-left-stroke arrows arrow1'></i>
          <p>1 / 9</p>
          <i class='bx bx-arrow-right-stroke arrows arrow2'></i>
        </div>
      </div>
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Find Errors!</button>
      </div>
      <button class="downloadbtn" id="uploadbtn"><i class="fa-solid fa-download"></i>Download File</button>
      <%- include('../components/footer') -%>
    </main>
  </div>
</body>

</html>