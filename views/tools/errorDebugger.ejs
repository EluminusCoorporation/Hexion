<%- include('../components/header', {
  color: 'indianred',
  icon: 'bx bx-alert-triangle',
  backButton: true,
  tag: 'TOOL'
}) -%>
      <div class="dropdown-container" id="dropDownMenu" data-action="selectExtension">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="Auto" style="color: var(--text)"><i class="bx bx-refresh-cw"></i>Auto</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <li class="dropdown-item selected" id="auto" data-ext="auto">
            <i class="bx bx-refresh-cw langIcon"></i>Auto
            <span class="tag">recommended</span>
          </li>
          <li class="dropdown-item" data-ext="html" id="html">
            <i class="bxl bx-html5 langIcon"></i>
            Html
          </li>
          <li class="dropdown-item" id="css" data-ext="css">
            <i class="bxl bx-css3 langIcon"></i>
            Css
          </li>
          <li class="dropdown-item" id="javascript" data-ext="js">
            <i class="bxl bx-javascript langIcon"></i>
            Java Script
          </li>
          <li class="dropdown-item" id="python" data-ext="py">
            <i class="bxl bx-python langIcon"></i>Python
          </li>
        </ul>
      </div>
      
      <div class="buttonWrapper">
        <div class="buttonIndicator" id="btnIndicator"></div>
        <button class="dualbtn dbtn1" id="fileMode">File mode</button>
        <button class="dualbtn dbtn2" id="textMode">Text mode</button>
      </div>
      <div class="switcherContainer">
        <div class="uploadWrapper selected" id="uploadWrapper">
          <input type="file" id="fileUploader" class="file-upload-input"/>
          <label for="fileUploader" class="file-upload-button" id="uploadZone">
            <i class='fa-solid fa-upload dragicon' id="fileIcon"></i>
            <p id="fileName" class="file-name">Upload File</p>
          </label>
        </div>
        <textarea name="textToConvert" id="textmodetxt" placeholder="Code Block" class="code-input-container" maxlength="3500" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"></textarea>
      </div>
      
      <div class="results-container" id="resultsContainer">
        <div class="results-div">
          <div class="ball-container">
            <div class="redball ball"></div>
            <div class="yellowball ball"></div>
            <div class="greenball ball"></div>
          </div>
          <div class="textarea-div">
            <textarea class="numbersPH" cols="5" readonly></textarea>
            <textarea class="codePH" maxlength="500" placeholder="Results" id="results" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"></textarea>
            <i class='bx bx-copy copy-button' id="copy-icon"></i>
          </div>
        </div>
        <div class="error-switch">
          <i class='bx bx-arrow-left-stroke arrows arrow1' id="errorGoBack"></i>
          <p id="errorCounter"><span id="currentError">1</span> / <span id="totalErrors">0</span></p>
          <i class='bx bx-arrow-right-stroke arrows arrow2' id="errorGoForward"></i>
        </div>
      </div>
      <div class="results-button-container">
        <button class="results-button" id="results-btn">Find Errors!</button>
      </div>
      <%- include('../components/footer') -%>