<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>
  <link rel="website icon" href="/global/logo.png">
  <link rel="stylesheet" href="/stylings/tools/errorDebugger.css">
  <link rel="stylesheet" href="/stylings/components/header.css">
  <link rel="stylesheet" href="/stylings/components/footer.css">
  <link rel="stylesheet" href="/stylings/components/effects/loading.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
  <title>Error Debugger(Tool)</title>
</head>

<body>
  <div class="container" id="container">
    <%- include('../components/effects/loading') -%>
    <%- include('../components/header') -%>
    <div class="addiv ad1">
      <p class="adp">Ad space here</p>
    </div>
    <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i><p>Back to dashboard</p></a>
    <h2 class="homeH2"><i class='bx bx-cube-alt homeI'></i>ErrorDebugger(Tool) </h2>
    <div id="errorDiv">
      <i class='bx bx-error'></i>
      <div class="linefordiv"></div>
      <p id="errorText"></p>
    </div>
    <div class="dropdown-container" id="dropDownMenu">
      <div class="head-i" id="textWrapper">
        <h3 class="dropdown-text" id="dropdown-text">Language Selector</h3>
        <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
      </div>
      <div class="dropdown-content" id="dropDownContent">
        <div class="select-item">
          <div class="imgWrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" class="langIcon" id="imgWrapper" />
            <p>Python</p>
          </div>
        </div>
        <div class="select-item">
          <div class="imgWrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg" class="langIcon"/>
            <p>Java Script</p>
          </div>
        </div>
        <div class="select-item">
          <div class="imgWrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original-wordmark.svg" class="langIcon" />
            <p>Html</p>
          </div>
        </div>
        <div class="select-item">
          <div class="imgWrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original-wordmark.svg" class="langIcon" />
            <p>Css</p>
          </div>
        </div>
      </div>
    </div>
    <div class="buttonWrapper">
      <div class="buttonIndicator" id="btnIndicator"></div>
      <button class="dualbtn dbtn1" id="dbtn1">File mode</button>
      <button class="dualbtn dbtn2" id="dbtn2">Text mode</button>
    </div>
    <input type="text" name="textToConvert" id="textmodetxt" placeholder="Text" class="ttc" maxlength="500" />
    <div class="uploadWrapper" id="uploadWrapper">
      <button class="uploadbtn" id="uploadbtn">Upload File</button>
    </div>
    <div class="flexbox-results" id="resultsDiv">
      <div class="results-div">
        <div class="ball-container">
          <div class="redball ball"></div>
          <div class="yellowball ball"></div>
          <div class="greenball ball"></div>
        </div>
        <div class="textarea-div">
          <textarea class="numbersPH" cols="5" readonly></textarea>
          <textarea class="codePH" maxlength="500" placeholder="Results" id="results"></textarea>
          <i class='bx bx-copy' id="tcopy"></i>
        </div>
      </div>
      <div class="error-switch">
        <i class='bx bx-arrow-left-stroke arrows arrow1'></i>
        <p>1 / 9</p>
        <i class='bx bx-arrow-right-stroke arrows arrow2'></i>
      </div>
    </div>
    <div class="results-btn-div">
      <button class="results-button" id="results-btn">Find Errors!</button>
    </div>
    <%- include('../components/footer') -%>
  </div>
  <div class="uploadMenu-container" id="uploadMenuC">
    <div class="uploadMenu" id="uploadMenu">
      <div id="errorDivUPLOAD">
        <i class='bx bx-error'></i>
        <div class="linefordiv"></div>
        <p id="errorTextUPLOAD"></p>
      </div>
      <div class="close-btn" id="close-btn">
        <i class="fa-solid fa-xmark"></i>
      </div>
      <input class="uploadFileMenu" type="file" id="file">
      <label for="file" class="uploadZone" id="uploadZone">
        <i class='bx bx-cloud-upload dragicon' id="fileIcon"></i>
        <p class="labelUpload" id="fileName">Drag and Drop or click to Upload</p>
        <div class="flexbox-upload" id="uploadBarContainer">
          <div class="flexbox-uploadinfo">
            <p class="upload-info" id="uploadInfo"></p>
            <p class="status" id="status">Waiting for network...</p>
          </div>
        </div>
        <div class="upload-bar-container">
          <div class="upload-bar" id="uploadBar"></div>
        </div>
      </label>
    </div>
  </div>
  <script src="/js/effects/loading.js"></script>
  <script src="/js/effects/drop-down-menu.js"></script>
  <script src="/js/tools/errordebugger/errorDebugger.js" type="module"></script>
  </script>
</body>

</html>