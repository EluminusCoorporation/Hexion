<%- include('../components/header') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="ad-container">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h2 class="page-header"><i class='bx bx-image'></i>Image Converter<span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h2>
      
      <div class="uploader-container">
        <input type="file" id="fileUploader" class="file-upload-input">
        <label for="fileUploader" class="file-upload-button" id="uploadZone">
          <i class='fa-solid fa-upload dragicon' id="fileIcon"></i>
          <p id="fileName" class="file-name">Upload Image</p>
        </label>
        <img id="imageShowcase"/>
      </div>
      
      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Format Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li class="tag-container"><p class="select-item">WEBP</p><span class="tag">recommended</span></li>
            <li><p class="select-item">PNG</p></li>
            <li><p class="select-item">JPG</p></li>
            <li><p class="select-item">JPEG</p></li>
            <li><p class="select-item">AVIF</p></li>
            <li><p class="select-item">MozJPEG</p></li>
            <li><p class="select-item">OxiPNG</p></li>
          </div>
        </ul>
      </div>
      
      <div class="range-container">
        <label>Quality <span id="rangeCount" class="range-progress">0%</span></label>
        <input id="qualityRange" class="ranges" type="range" min="0" max="100" value="0">
      </div>
      
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Convert!</button>
      </div>
      <script src="https://cdn.jsdelivr.net/npm/eruda"></script>
<script>eruda.init();</script>
      <%- include('../components/footer') -%>