<%- include('../components/header') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="ad-container">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h2 class="page-header"><i class='bx bx-image'></i>Image Converter<span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h2>
      
      <div class="uploader-container">
        <input type="file" id="fileUploader" class="file-upload-input">
        <label for="fileUploader" class="file-upload-button" id="uploadZone">
          <i class='fa-solid fa-upload dragicon' id="fileIcon"></i>
          <p id="fileName" class="file-name">Upload Image</p>
        </label>
        <img id="imageShowcase"/>
      </div>
      
      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Format Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li class="tag-container"><p class="select-item">WEBP</p><span class="tag">recommended</span></li>
            <li><p class="select-item">PNG</p></li>
            <li><p class="select-item">JPEG</p></li>
            <li><p class="select-item">AVIF</p></li>
            <li><p class="select-item">MozJPEG</p></li>
            <li><p class="select-item">OxiPNG</p></li>
          </div>
        </ul>
      </div>
      
      <div class="range-container">
        <label>Quality <span id="rangeCount" class="range-progress">100%</span></label>
        <input id="qualityRange" class="ranges" type="range" min="10" max="100" value="100">
      </div>
      
      <div class="image-editor-container">
        <div class="input-label-container">
          <label>Resize:</label>
          <div class="double-input-container">
            <input type="number" name="textToConvert" id="resizeXInput" placeholder="ResizeX" class="input-container"/>
            <span>X</span>
            <input type="number" name="textToConvert" id="resizeYInput" placeholder="ResizeY" class="input-container"/>
          </div>
        </div>
        <div class="input-label-container">
          <label>Crop:</label>
          <button id="cropMenuButton" class="crop-menu-button">Open Cropper</button>
          
          <div class="cropper-menu-container" id="cropperMenuContainer">
            <div class="cropper-menu" id="cropperMenu">
              <i class="bx bx-x cropper-close-button" id="cropperCloseButton" role="button"></i>
              <h3>Image Cropper</h3>
              <div class="loader-fallback">
                <i class="bx bx-refresh-ccw"></i>
              </div>
              <div class="no-content-fallback">
                <i class="bx bx-x"></i>
                <h4>No Image Uploaded</h4>
                <p>No uploaded image was found, please upload an image.</p>
              </div>
              <div class="image-container">
                <img id="cropperImage">
                <div class="image-metrics-container">
                  <div class="image-metric"><span>X:</span><p id="xField">NaH</p></div>
                  <div class="image-metric"><span>Y:</span><p id="yField">NaH</p></div>
                  <div class="image-metric"><span>Width:</span><p id="widthField">NaH</p></div>
                  <div class="image-metric"><span>Height:</span><p id="heightField">NaH</p></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <a class="download-button" id="imageDownloadButton" role="button"><i class='fa-solid fa-download'></i>Download Image</a>
      
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Convert!</button>
      </div>
      <script src="https://cdn.jsdelivr.net/npm/eruda"></script>
<script>eruda.init();</script>
      <%- include('../components/footer') -%>
      
      