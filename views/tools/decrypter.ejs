<%- include('../components/header') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="ad-container">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h1 class="page-header"><i class='bx bx-lock'></i><p>Decrypter</p><span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h1>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Format Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li><p class="select-item">Base85</p></li>
            <li><p class="select-item">ROT13</p></li>
            <li><p class="select-item">Caesar Cipher</p></li>
            <li><p class="select-item">Atbash Cipher</p></li>
            <li><p class="select-item">Morse Code</p></li>
            <li><p class="select-item">Binary Encoding</p></li>
            <li><p class="select-item">Hexadecimal Encoding</p></li>
            <li><p class="select-item">Rail Fence Cipher</p></li>
            <li><p class="select-item">Vigenère Cipher</p></li>
            <li><p class="select-item">Affine Cipher</p></li>
          </div>
        </ul>
      </div>
      <input type="text" name="textToConvert" id="inputContainer" placeholder="Text" class="input-container" maxlength="500" />
      <div class="flexbox-results" id="resultsContainer">
        <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Results"></textarea>
        <i class='bx bx-copy' id="copy-icon"></i>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Decrypt!</button>
      </div>
      <%- include('../components/footer') -%>