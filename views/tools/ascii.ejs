<%- include('../components/header') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="ad-container">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h1 class="page-header"><i class='bx bx-code'></i><p>Ascii Art Generator</p><span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h1>
      <input type="text" name="textToConvert" id="inputContainer" placeholder="Text" class="input-container" maxlength="1500" />
      <input type="number" name="asciiWidth" id="asciiWidth" placeholder="Width (Optional)" class="input-container"/>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Font Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li class="tag-container"><p class="select-item">Default</p></li>
            <li><p class="select-item">UTF-16</p></li>
            <li><p class="select-item">UTF-32</p></li>
            <li><p class="select-item">Base 64</p></li>
            <li><p class="select-item">ASCII</p></li>
            <li><p class="select-item">EXTENDED ASCII</p></li>
            <li><p class="select-item">Binary</p></li>
            <li><p class="select-item">Shift Jis</p></li>
            <li><p class="select-item">ISO 8859-1</p></li>
            <li><p class="select-item">Morse Code</p></li>
          </div>
        </ul>
      </div>
      <div class="double-dropdown-container">
        <div class="dropdown-container" id="dropDownMenu">
          <div class="dropdown-header-container">
            <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Horizontal</h3>
            <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
          </div>
          <ul class="dropdown-content" id="dropDownContent">
            <div>
              <li class="tag-container"><p class="select-item">Default</p></li>
              <li><p class="select-item">Full</p></li>
              <li><p class="select-item">Fitted</p></li>
              <li><p class="select-item">Smushing</p></li>
              <li><p class="select-item">Universal Smushing</p></li>
            </div>
          </ul>
        </div>
        <div class="dropdown-container" id="dropDownMenu">
          <div class="dropdown-header-container">
            <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Verticle</h3>
            <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
          </div>
          <ul class="dropdown-content" id="dropDownContent">
            <div>
              <li class="tag-container"><p class="select-item">Default</p></li>
              <li><p class="select-item">Full</p></li>
              <li><p class="select-item">Fitted</p></li>
              <li><p class="select-item">Smushing</p></li>
              <li><p class="select-item">Universal Smushing</p></li>
            </div>
          </ul>
        </div>
      </div>
      <div class="option-container">
        <!-- From Uiverse.io by andrew-demchenk0 --> 
        <label class="switch">
          <input class="toggle" type="checkbox" id="whiteSpaceBreakCheckbox">
          <span class="slider"></span>
          <span class="card-side"></span>
        </label>
        <p class="option-name">White Space Breaks</p>
      </div>
      <div class="flexbox-results" id="resultsContainer">
        <textarea name="results" id="results" class="results" placeholder="Results" readonly></textarea>
        <i class='bx bx-copy' id="copy-icon"></i>
      </div>
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Generate!</button>
      </div>
      <%- include('../components/footer') -%>