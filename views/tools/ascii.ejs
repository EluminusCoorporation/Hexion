<%- include('../components/header', {
  color: 'deepskyblue',
  icon: 'bx bx-hourglass',
  backButton: true,
  tag: 'TOOL'
}) -%>

      <input type="text" name="textToConvert" id="inputContainer" placeholder="Text" class="input-container" maxlength="1500" />
      <input type="number" name="asciiWidth" id="asciiWidth" placeholder="Width (Optional)" class="input-container"/>
      <div class="combobox-container" id="comboboxContainer">
        <div class="dropdown-header-container">
          <div class="search-container">
            <input type="search" class="combobox" placeholder="Search Fonts..." id="fontsSearch" data-selected=""/>
            <i class="bx bx-x clear-search-button" id="clearSearchButton"></i>
          </div>
          <i class='bx bx-chevron-down dropdown-icon'></i>
        </div>
        <ul class="dropdown-content" id="searchItemList">
          <p class="search-alert">Loading fonts...</p>
        </ul>
      </div>
      <div class="double-dropdown-container">
        <div class="dropdown-container" id="dropDownMenu">
          <div class="dropdown-header-container">
            <h3 class="dropdown-selected horizontal-layout" id="dropdownSelected" data-selected="">Horizontal</h3>
            <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
          </div>
          <ul class="dropdown-content" id="dropDownContent">
            <li class="select-item">Default</li>
            <li class="select-item">Full</li>
            <li class="select-item">Fitted</li>
            <li class="select-item">Smushing</li>
            <li class="select-item">Universal Smushing</li>
          </ul>
        </div>
        <div class="dropdown-container" id="dropDownMenu">
          <div class="dropdown-header-container">
            <h3 class="dropdown-selected vertical-layout" id="dropdownSelected" data-selected="">Vertical</h3>
            <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
          </div>
          <ul class="dropdown-content" id="dropDownContent">
            <li class="select-item">Default</li>
            <li class="select-item">Full</li>
            <li class="select-item">Fitted</li>
            <li class="select-item">Smushing</li>
            <li class="select-item">Universal Smushing</li>
          </ul>
        </div>
      </div>
      <div class="option-container">
        <!-- From Uiverse.io by andrew-demchenk0 --> 
        <label class="switch">
          <input class="toggle" type="checkbox" id="whiteSpaceBreak">
          <span class="slider"></span>
          <span class="card-side"></span>
        </label>
        <p class="option-name">White Space Breaks</p>
      </div>
      <div class="flexbox-results" id="resultsContainer">
        <textarea name="results" id="results" class="results" placeholder="Results" readonly></textarea>
        <i class='bx bx-copy' id="copy-icon"></i>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Generate!</button>
      </div>
      <%- include('../components/footer') -%>