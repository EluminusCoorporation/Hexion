<%- include('../components/header') -%>

<body>
  <div class="container">
    <%- include('../components/effects/loader') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="addiv">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h2 class="pageH2"><i class='bx bx-palette'></i>Gradient<br>Generator <span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h2>
      <div class="color-pallete-container" id="colorPalleteContainer">
        <div class="color-dropdownmenu" id="colorDropdownmenu">
          <i class='bx bx-chevron-down active' id="colorDropdownmenuIcon"></i>
          <p>Color palletes</p>
        </div>
        <div class="colors-grid-container show" id="colorsGridContainer">
          <div>
            <ul class="colors-container" id="colorsContainer">
              
              <li class="color-container use-as-clone" id="colorContainer">
                <div class="color-preview"></div>
                <div class="color-name-container">
                  <i class='bx bx-copy' id="copyIcon"></i>
                  <p class="color-name">#00FF7F</p>
                </div>
                <div class="movers-container">
                  <i class='bx bx-chevron-up mover' id="moveUp"></i>
                  <i class='bx bx-chevron-down mover' id="moveDown"></i>
                </div>
              </li>
              <li class="color-container">
                <div class="color-preview"></div>
                <div class="color-name-container">
                  <i class='bx bx-copy' id="copyIcon"></i>
                  <p class="color-name">#00FF7F</p>
                </div>
                <div class="movers-container">
                  <i class='bx bx-chevron-up mover' id="moveUp"></i>
                  <i class='bx bx-chevron-down mover' id="moveDown"></i>
                </div>
                <i class='bx bx-trash delete-icon'></i>
              </li>
            </ul>
            <p class="error-message" id="errorMessage">You reached the limit of colors (15)</p>
            <button class="addColor-btn" id="addColorButton">+ Add Color</button>
          </div>
        </div>
      </div>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="head-i">
          <h3 class="dropdown-text" id="dropdown-text">&#rrggbb</h3>
          <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li><p class="select-item special">&#rrggbb<span class="recommended" id="spanR">recommended</span></p></li>
            <li><p class="select-item">§x§r§r§g§g§b§b</p></li>
            <li><p class="select-item">&x&r&r&g&g&b&b</p></li>
            <li><p class="select-item"><#rrggbb></p></li>
          </div>
        </ul>
      </div>
      <div class="styler-container" id="stylerContainer">
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="bold" /><i class='bx bx-bold icon'></i></label>
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="underline" /><i class='bx bx-underline icon'></i></label>
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="italic" /><i class='bx bx-italic icon'></i></label>
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="strikethrough" /><i class='bx bx-strikethrough icon'></i></label>
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="obfuscation" /><i class='bx bx-magic-wand icon'></i></label>
      </div>
      <input type="text" name="textToConvert" id="inputText" placeholder="Text" class="ttc" maxlength="50" value="Hexion" />
      
      <div class="preview-screen-container">
        <h4 class="preview-header">Preview Screen</h4>
        <div class="preview-screen">
          <h3 class="preview-text" id="previewText" style="font-weight: unset;" data-text="Hexion">Hexion</h3>
        </div>
      </div>
      
      <div class="flexbox-results" id="resultsDiv">
        <div class="results-div">
          <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Results"></textarea>
          <i class='bx bx-copy' id="copy-icon"></i>
        </div>
      </div>
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
    </main>
    <%- include('../components/footer') -%>
  </div>
  <!--Module imports-->
<script src="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/pickr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/eruda"></script>
<script>eruda.init();</script>
</body>

</html>