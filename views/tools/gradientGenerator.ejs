<%- include('../components/header', {
  color: 'purple',
  icon: 'bx bx-palette',
  backButton: true,
  tag: 'TOOL'
}) -%>

      <div class="color-pallete-container" id="colorPalleteContainer">
        <div class="color-dropdownmenu" id="colorDropdownmenu">
          <i class='bx bx-chevron-down active' id="colorDropdownmenuIcon"></i>
          <p>Color palletes</p>
        </div>
        <div class="colors-grid-container show" id="colorsGridContainer">
          <div>
            <ul class="colors-container" id="colorsContainer">
              <li class="color-container use-as-clone" id="colorContainer" style="animation: expandIn 150ms ease-out forwards;">
                <p class="color-error-message">Too many colors!</p>
                <div>
                  <div class="color-preview"></div>
                  <div class="color-name-container">
                    <i class='bx bx-copy' id="copyIcon"></i>
                    <p class="color-name">#00FF7F</p>
                  </div>
                  <div class="movers-container">
                    <i class='bx bx-chevron-up mover' id="moveUp"></i>
                    <i class='bx bx-chevron-down mover' id="moveDown"></i>
                  </div>
                </div>
              </li>
              <li class="color-container" style="animation: expandIn 150ms ease-out forwards;">
                <p class="color-error-message">Too many colors!</p>
                <div>
                  <div class="color-preview"></div>
                  <div class="color-name-container">
                    <i class='bx bx-copy' id="copyIcon"></i>
                    <p class="color-name" style="color: #92ffd6">#92FFD6</p>
                  </div>
                  <div class="movers-container">
                    <i class='bx bx-chevron-up mover' id="moveUp"></i>
                    <i class='bx bx-chevron-down mover' id="moveDown"></i>
                  </div>
                </div>
                <i class='bx bx-trash delete-icon'></i>
              </li>
            </ul>
            <p class="error-message" id="errorMessage">You have reached the limit of colors <span>(5)</span></p>
            <button class="addColor-btn" id="addColorButton">+ Add Color</button>
          </div>
        </div>
      </div>
      <div class="dropdown-container" id="dropDownMenu" data-action="refreshOutput">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="&#rrggbb" style="color: var(--text)">&#rrggbb</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <li class="dropdown-item special selected">&#rrggbb<span class="tag">recommended</span></li>
          <li class="dropdown-item">§x§r§r§g§g§b§b</li>
          <li class="dropdown-item">&x&r&r&g&g&b&b</li>
          <li class="dropdown-item"><#rrggbb></li>
          <li class="dropdown-item">[COLOR=#rrggbb][/COLOR]</li>
          <li class="dropdown-item">JSON</li>
        </ul>
      </div>
      <div class="styler-container" id="stylerContainer">
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="bold" /><i class='bx bx-bold icon'></i></label>
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="italic" /><i class='bx bx-italic icon'></i></label>
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="underline" /><i class='bx bx-underline icon'></i></label>
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="strikethrough" /><i class='bx bx-strikethrough icon'></i></label>
        <label class="styler-label"><input type="checkbox" class="stylers" data-style="obfuscation" /><i class='bx bx-magic-wand icon'></i></label>
      </div>
      <input type="number" name="characterspercolor" id="inputChars" placeholder="Characters Per Color" class="input-container" value="1" style="margin-bottom: .75em;" />
      <input type="text" name="textToConvert" id="inputText" placeholder="Text" class="input-container" value="Hexion" />
      <div class="options-container">
        <div class="option-container">
          <!-- From Uiverse.io by andrew-demchenk0 --> 
          <label class="switch">
            <input class="toggle" type="checkbox" data-type="trim">
            <span class="slider"></span>
            <span class="card-side"></span>
          </label>
          <p class="option-name">Trim spaces</p>
        </div>
        <div class="option-container">
          <!-- From Uiverse.io by andrew-demchenk0 --> 
          <label class="switch">
            <input class="toggle" type="checkbox" data-type="lowercaseHex">
            <span class="slider"></span>
            <span class="card-side"></span>
          </label>
          <p class="option-name">Lowercase hex codes</p>
        </div>
      </div>
      
      <div class="preview-screen-container">
        <h4 class="preview-header">Preview Screen</h4>
        <div class="preview-screen">
          <div class="preview-text" id="previewText" style="font-weight: unset;" data-text="Hexion">
          </div>
        </div>
      </div>
      
      <div class="results-container" id="resultsContainer">
        <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Results" readonly></textarea>
      </div>
      <%- include('../components/footer') -%>