<%- include('../components/header') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="ad-container">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h1 class="page-header"><i class="bx bx-water-drop-alt"></i><p>Color Converter</p><span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h1>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Color Format Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
      <input type="text" name="textToConvert" id="inputContainer" placeholder="Color Code" class="input-container" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li class="tag-container"><p class="select-item">OKlch</p><span class="tag">recommended</span></li>
            <li><p class="select-item">Oklab</p></li>
            <li><p class="select-item">lch</p></li>
            <li><p class="select-item">lab</p></li>
            <li><p class="select-item">Rgb</p></li>
            <li><p class="select-item">Rgba</p></li>
            <li><p class="select-item">Hex</p></li>
            <li><p class="select-item">Hsl</p></li>
            <li><p class="select-item">Hsla</p></li>
            <li><p class="select-item">Hwb</p></li>
            <li><p class="select-item">Color Names</p></li>
          </div>
        </ul>
      </div>
      <div class="flexbox-results" id="resultsContainer">
        <textarea name="results" id="results" class="results" placeholder="Results"></textarea>
        <i class='bx bx-copy' id="copy-icon"></i>
      </div>
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Convert!</button>
      </div>
      <%- include('../components/footer') -%>