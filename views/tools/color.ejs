<%- include('../components/header', {
  color: 'floralwhite',
  icon: 'bx bx-water-drop-alt',
  backButton: true,
  tag: 'TOOL'
}) -%>

      <input type="text" name="textToConvert" id="inputContainer" placeholder="Color Code" class="input-container" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Color Format Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <li class="select-item">Oklch<span class="tag">recommended</span></li>
          <li class="select-item">Oklab</li>
          <li class="select-item">lch</li>
          <li class="select-item">lab</li>
          <li class="select-item">Rgb</li>
          <li class="select-item">Hex</li>
          <li class="select-item">Hsl</li>
          <li class="select-item">Hwb</li>
        </ul>
      </div>
      <div class="color-showcase" id="colorShowcaseContainer">
        <div class="color-name-container">
          <p class="color-name" id="colorNameValue"></p>
          <i class='bx bx-copy copy-button' data-el="colorNameValue" id="copy-icon"></i>
        </div>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Convert!</button>
      </div>
      <%- include('../components/footer') -%>