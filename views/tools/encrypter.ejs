<%- include('../components/header', {
  color: 'orange',
  icon: 'bx bx-shield-quarter',
  backButton: true,
  tag: 'TOOL'
}) -%>

      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Format Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <li class="select-item">Base85<span class="tag">recommended</span></li>
          <li class="select-item">ROT13</li>
          <li class="select-item">Caesar Cipher</li>
          <li class="select-item">Atbash Cipher</li>
          <li class="select-item">Morse Code</li>
          <li class="select-item">Binary Encoding</li>
          <li class="select-item">Hexadecimal Encoding</li>
          <li class="select-item">Rail Fence Cipher</li>
          <li class="select-item">Vigenère Cipher</li>
          <li class="select-item">Affine Cipher</li>
        </ul>
      </div>
      <input type="text" name="textToConvert" id="inputContainer" placeholder="Text" class="input-container" maxlength="500" />
      <div class="flexbox-results" id="resultsContainer">
        <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Results"></textarea>
        <i class='bx bx-copy' id="copy-icon"></i>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Encrypt!</button>
      </div>
      <%- include('../components/footer') -%>