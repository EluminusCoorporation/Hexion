<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('../components/layout') -%>
  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>
  <link rel="stylesheet" href="/stylings/tools/encrypter.css">
  <link rel="stylesheet" href="/stylings/components/header.css">
  <link rel="stylesheet" href="/stylings/components/footer.css">
  <link rel="stylesheet" href="/stylings/components/effects/loading.css">
  <link rel="stylesheet" href="/stylings/__global_variables__.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
  <!--function Import-->
  <script src="/js/effects/loading.js" defer></script>
  <script src="/js/tools/encrypter.js" type="module" defer></script>
  <title>Encrypting</title>
</head>

<body>
  <div class="container">
    <%- include('../components/effects/loading') -%>
    <%- include('../components/header') -%>
    <main>
      <div class="addiv">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h2 class="pageH2"><i class='bx bx-shield-quarter'></i>Encrypting <span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h2>
      <div id="errorDiv">
        <i class='bx bx-alert-triangle'></i>
        <div class="linefordiv"></div>
        <p id="errorText"></p>
      </div>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="head-i">
          <h3 class="dropdown-text" id="dropdown-text">Format Selector</h3>
          <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li><p class="select-item">Base85 <span class="recommended" id="spanR">recommended</span></p></li>
            <li><p class="select-item">ROT13</p></li>
            <li><p class="select-item">Caesar Cipher</p></li>
            <li><p class="select-item">Atbash Cipher</p></li>
            <li><p class="select-item">Morse Code</p></li>
            <li><p class="select-item">Binary Encoding</p></li>
            <li><p class="select-item">Hexadecimal Encoding</p></li>
            <li><p class="select-item">Rail Fence Cipher</p></li>
            <li><p class="select-item">Vigenère Cipher</p></li>
            <li><p class="select-item">Affine Cipher</p></li>
          </div>
        </ul>
      </div>
      <input type="text" name="textToConvert" id="ttc" placeholder="Text" class="ttc" maxlength="500" />
      <div class="flexbox-results" id="resultsDiv">
        <div class="results-div">
          <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Results"></textarea>
          <i class='bx bx-copy' id="copy-icon"></i>
        </div>
      </div>
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Encrypt!</button>
      </div>
      <%- include('../components/footer') -%>
    </main>
  </div>
</body>

</html>