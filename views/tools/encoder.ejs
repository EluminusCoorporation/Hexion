<%- include('../components/header') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="ad-container">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h1 class="page-header"><i class='bx bx-code'></i><p>Encoder</p><span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h1>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected" id="dropdownSelected" data-selected="">Format Selector</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <li class="select-item tag-container">UTF-8<span class="tag">recommended</span></li>
          <li class="select-item">UTF-16</li>
          <li class="select-item">UTF-32</li>
          <li class="select-item">Base 64</li>
          <li class="select-item">ASCII</li>
          <li class="select-item">EXTENDED ASCII</li>
          <li class="select-item">Binary</li>
          <li class="select-item">Shift Jis</li>
          <li class="select-item">ISO 8859-1</li>
          <li class="select-item">Morse Code</li>
        </ul>
      </div>
      <input type="text" name="textToConvert" id="inputContainer" placeholder="Text" class="input-container" maxlength="500" />
      <div class="flexbox-results" id="resultsContainer">
        <textarea name="results" id="results" class="results" placeholder="Results"></textarea>
        <i class='bx bx-copy' id="copy-icon"></i>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Encode!</button>
      </div>
      <%- include('../components/footer') -%>