<%- include('../components/header') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="addiv">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h2 class="pageH2"><i class='bx bx-code'></i>Encoder <span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h2>
      <div class="dropdown-container" id="dropDownMenu">
        <div class="head-i">
          <h3 class="dropdown-text" id="dropdown-text" data-selected="">Format Selector</h3>
          <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li class="recommend-container"><p class="select-item">UTF-8</p><span class="recommended">recommended</span></li>
            <li><p class="select-item">UTF-16</p></li>
            <li><p class="select-item">UTF-32</p></li>
            <li><p class="select-item">Base 64</p></li>
            <li><p class="select-item">ASCII</p></li>
            <li><p class="select-item">EXTENDED ASCII</p></li>
            <li><p class="select-item">Binary</p></li>
            <li><p class="select-item">Shift Jis</p></li>
            <li><p class="select-item">ISO 8859-1</p></li>
            <li><p class="select-item">Morse Code</p></li>
          </div>
        </ul>
      </div>
      <input type="text" name="textToConvert" id="ttc" placeholder="Text" class="ttc" maxlength="500" />
      <div class="flexbox-results" id="resultsDiv">
          <textarea name="results" id="results" class="results" placeholder="Results"></textarea>
          <i class='bx bx-copy' id="copy-icon"></i>
      </div>
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Encode!</button>
      </div>
      <%- include('../components/footer') -%>