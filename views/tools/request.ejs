<%- include('../components/header', {
  color: 'hotpink',
  icon: 'bx bx-wifi',
  backButton: true,
  tag: 'TOOL'
}) -%>
      
      <div class="info-container">
        <p><b>Note:</b> That all of this information must exactly match you're backend's configuration.</p>
      </div>
      
      <div class="url-container">
        <div class="dropdown-container request-type" id="dropDownMenu" data-action="checkTypes">
          <div class="dropdown-header-container">
            <h3 class="dropdown-selected type" id="dropdownSelected" data-selected="">Type</h3>
            <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
          </div>
        
          <ul class="dropdown-content" id="dropDownContent">
            <li class="dropdown-item">GET</li>
            <li class="dropdown-item">POST</li>
            <li class="dropdown-item">PUT</li>
            <li class="dropdown-item">DELETE</li>
          </ul>
        </div>
        <input type="text" name="textToConvert" id="inputContainer" placeholder="Url" class="input-container url-input" maxlength="50" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
      </div>
      
      <div class="dropdown-container input-selectors" id="dropDownMenu" data-action="refreshBody">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected content body-type" id="dropdownSelected" data-selected="">Content-Type</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <li class="dropdown-item">application/json</li>
          <li class="dropdown-item">application/x-www-form-urlencoded</li>
          <li class="dropdown-item">multipart/form-data</li>
          <li class="dropdown-item">text/plain</li>
          <li class="dropdown-item">application/xml</li>
          <li class="dropdown-item">application/octet-stream</li>
          <li class="dropdown-item">application/graphql</li>
        </ul>
      </div>
      <div class="dropdown-container input-selectors" id="dropDownMenu" data-id="AcceptTypeSelector">
        <div class="dropdown-header-container">
          <h3 class="dropdown-selected accept" id="dropdownSelected" data-selected="">Accept (Optional)</h3>
          <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <li class="dropdown-item">application/json</li>
          <li class="dropdown-item">application/x-www-form-urlencoded</li>
          <li class="dropdown-item">multipart/form-data</li>
          <li class="dropdown-item">text/plain</li>
          <li class="dropdown-item">application/xml</li>
          <li class="dropdown-item">application/octet-stream</li>
          <li class="dropdown-item">application/graphql</li>
        </ul>
      </div>
      
      <div class="options-container">
        <div class="option-container">
          <!-- From Uiverse.io by andrew-demchenk0 --> 
          <div class="option-content">
            <label class="switch">
              <input class="toggle authToggler" type="checkbox" data-el="authContainer">
              <span class="slider"></span>
              <span class="card-side"></span>
            </label>
            <p class="option-name">Authorization</p>
          </div>
          <div id="authContainer" class="toggler-el">
            <div class="dropdown-container authEl" id="dropDownMenu" data-action="checkAuthType">
              <div class="dropdown-header-container">
                <h3 class="dropdown-selected auth-type" id="dropdownSelected" data-selected="">Type Selector</h3>
                <i class='bx bx-chevron-down dropdown-icon' id="dropdownIcon"></i>
              </div>
              <ul class="dropdown-content" id="dropDownContent">
                <li class="dropdown-item">Bearer Token</li>
                <li class="dropdown-item">Basic Auth</li>
                <li class="dropdown-item">Custom</li>
              </ul>
            </div>
            <input placeholder="Authorization" type="text" name="authKey" id="auth" class="input-container authEl"/>
          </div>
        </div>
        <div class="option-container">
          <!-- From Uiverse.io by andrew-demchenk0 --> 
          <div class="option-content">
            <label class="switch">
              <input class="toggle timeoutToggler" type="checkbox">
              <span class="slider"></span>
              <span class="card-side"></span>
            </label>
            <p class="option-name">Disable timeout</p>
          </div>
        </div>
      </div>
      <div>
        <div class="content-div">
          <textarea name="body" id="contentBody" class="content-body" rows="12" cols="80" placeholder="body" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"></textarea>
        </div>
      </div>
      
      <div class="flexbox-header" id="headerContainer">
          <textarea name="headers" id="headers" class="content-body" rows="12" cols="80" placeholder="Headers" readonly></textarea>
      </div>
      
      <div class="flexbox-results" id="resultsContainer">
        <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Response"></textarea>
        <i class='bx bx-copy copy-button' id="copy-icon"></i>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Send Request!</button>
      </div>
      <%- include('../components/footer') -%>