<%- include('../components/header') -%>
    <%- include('../components/navbar') -%>
    <main>
      <div class="addiv">
        <p>Ad space here</p>
      </div>
      <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
        <p>Back to dashboard</p>
      </a>
      <h2 class="pageH2"><i class='bx bx-wifi'></i>Request Sender <span class="header-tag"><i class="bx bx-spanner"></i>TOOL</span></h2>
      
      <div class="info-container">
        <p><b>Note:</b> That all of this information must exactly match you're backend's configuration.</p>
      </div>
      
      <div class="url-container">
        <div class="dropdown-container request-type" id="dropDownMenu" data-action="checkTypes">
          <div class="head-i">
            <h3 class="dropdown-text type" id="dropdown-text" data-selected="">Type</h3>
            <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
          </div>
        
          <ul class="dropdown-content" id="dropDownContent">
            <div>
              <li><p class="select-item">GET</p></li>
              <li><p class="select-item">POST</p></li>
              <li><p class="select-item">PUT</p></li>
              <li><p class="select-item">DELETE</p></li>
            </div>
          </ul>
        </div>
        <input type="text" name="textToConvert" id="ttc" placeholder="Url" class="ttc url-input" maxlength="50" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
      </div>
      
      <div class="dropdown-container input-selectors" id="dropDownMenu" data-action="refreshBody">
        <div class="head-i">
          <h3 class="dropdown-text content body-type" id="dropdown-text" dataset-selected="">Content-Type</h3>
          <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li><p class="select-item">application/json</p></li>
            <li><p class="select-item">application/x-www-form-urlencoded</p></li>
            <li><p class="select-item">multipart/form-data</p></li>
            <li><p class="select-item">text/plain</p></li>
            <li><p class="select-item">application/xml</p></li>
            <li><p class="select-item">application/octet-stream</p></li>
            <li><p class="select-item">application/graphql</p></li>
          </div>
        </ul>
      </div>
      <div class="dropdown-container input-selectors" id="dropDownMenu" data-id="AcceptTypeSelector">
        <div class="head-i">
          <h3 class="dropdown-text accept" id="dropdown-text" dataset-selected="">Accept (Optional)</h3>
          <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
        </div>
        <ul class="dropdown-content" id="dropDownContent">
          <div>
            <li><p class="select-item">application/json</p></li>
            <li><p class="select-item">application/x-www-form-urlencoded</p></li>
            <li><p class="select-item">multipart/form-data</p></li>
            <li><p class="select-item">text/plain</p></li>
            <li><p class="select-item">application/xml</p></li>
            <li><p class="select-item">application/octet-stream</p></li>
            <li><p class="select-item">application/graphql</p></li>
          </div>
        </ul>
      </div>
      
      <div class="options-container">
        <div class="option-container">
          <!-- From Uiverse.io by andrew-demchenk0 --> 
          <div class="option-content">
            <label class="switch">
              <input class="toggle authToggler" type="checkbox" data-el="authContainer">
              <span class="slider"></span>
              <span class="card-side"></span>
            </label>
            <p class="option-name">Authorization</p>
          </div>
          <div id="authContainer" class="toggler-el">
            <div class="dropdown-container authEl" id="dropDownMenu" data-action="checkAuthType">
              <div class="head-i">
                <h3 class="dropdown-text auth-type" id="dropdown-text" data-selected="">Type Selector</h3>
                <i class='bx bx-chevron-down dd-i' id="ddIcon"></i>
              </div>
              <ul class="dropdown-content" id="dropDownContent">
                <div>
                  <li><p class="select-item">Bearer Token</p></li>
                  <li><p class="select-item">Basic Auth</p></li>
                  <li><p class="select-item">Custom</p></li>
                </div>
              </ul>
            </div>
            <input type="text" name="authKey" id="auth" placeholder="Bearer Token" class="ttc authEl"/>
          </div>
        </div>
        <div class="option-container">
          <!-- From Uiverse.io by andrew-demchenk0 --> 
          <div class="option-content">
            <label class="switch">
              <input class="toggle timeoutToggler" type="checkbox">
              <span class="slider"></span>
              <span class="card-side"></span>
            </label>
            <p class="option-name">Disable timeout</p>
          </div>
        </div>
      </div>
      <div>
        <div class="content-div">
          <textarea name="body" id="contentBody" class="content-body" rows="12" cols="80" placeholder="body" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"></textarea>
        </div>
      </div>
      
      <div class="flexbox-header" id="headerContainer">
        <div class="content-div">
          <textarea name="headers" id="headers" class="content-body" rows="12" cols="80" placeholder="Headers"></textarea>
        </div>
      </div>
      
      <div class="flexbox-results" id="resultsDiv">
        <div class="results-div">
          <textarea name="results" id="results" class="results" rows="12" cols="80" placeholder="Response"></textarea>
          <i class='bx bx-copy' id="copy-icon"></i>
        </div>
      </div>
      <div class="copy-alert-container" id="copyAlertContainer">
        <i class="bx bx-clipboard-check"></i>
        <p>Copied to clipboard!</p>
      </div>
      <div class="results-btn-div">
        <button class="results-button" id="results-btn">Send Request!</button>
      </div>
      <%- include('../components/footer') -%>