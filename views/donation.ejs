<%- include('components/header', {
  color: 'springgreen',
  icon: 'bx bxs-gift',
  backButton: false
}) -%>
      <div class="donation-container">
        <p>Donation is another way for us to make money apart from the ads, these two are the main reasons on how this website runs so to contribute to run this website full of developer tools forever ,donate now.</p>
        <span>Payment Methods: Paypal</span>
        
        <button class="donation-btn" id="donationBtn">Donate now!</button>
        
        <div class="donation-menu-container" id="donationMenuContainer">
          <div id="donationMenu" class="donation-menu">
            <i class="bx bx-x payment-close-btn" id="paymentCloseBtn" role="button"></i>
            <h3>Payment</h3>
            <div class="inputs">
              <input type="number" name="amount" id="amount" placeholder="Amount">
            </div>
          </div>
        </div>
      </div>
      <%- include('components/footer') -%>
<script defer>
// Necessary element imports
const donationBtn = document.getElementById("donationBtn");
const donationMenuContainer = document.getElementById("donationMenuContainer");
const donationMenu = document.getElementById("donationMenu");
const closeBtn = document.getElementById("paymentCloseBtn");

donationBtn.addEventListener("click", () => {
  // Activates the donation menu
  donationMenuContainer.classList.add("active");
  donationMenu.classList.add("active");
});

// Close button used to close the donation menu
closeBtn.addEventListener("click", () => {
  // Deactivates the donation menu
  donationMenuContainer.classList.remove("active");
  donationMenu.classList.remove("active");
});
</script>