<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>
  </link>
  <link rel="website icon" href="/global/logo.png">
  <link rel="stylesheet" href="/stylings/donation.css">
  <link rel="stylesheet" href="/stylings/components/header.css">
  <link rel="stylesheet" href="/stylings/components/footer.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
  <title>Donations</title>
</head>
<body>
  <div class="container">
    <div id="preloader">
      <svg class="circular" viewBox="25 25 50 50">
        <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="3.5" stroke-miterlimit="10"></circle>
      </svg>
    </div>
    <%- include('components/header') -%>
    <div class="addiv ad1">
      <p class="adp">Ad space here</p>
    </div>
    <h2 class="homeH2"><i class='bx bx-cube-alt homeI'></i>Donations</h2>
    <div class="donation-div">
      <p>Donation is another way for us to make money apart from the ads these two are the main reasons on how this website runs so to contribute to run this website full of developer tools forever please donate us some money.</p>
      <h3>Payment Methods: Paypal</h3>
      <button class="donation-btn" id="donation-btn">Donate now!</button>
    </div>
    <%- include('components/footer') -%>
  </div>
  <div class="donation-menu-div" id="donation-menu-div">
    <div id="donation-menu" class="donation-menu">
      <div class="close-btn" id="close-btn">
        <i class="fa-solid fa-xmark"></i>
      </div>
      <h2>Payment</h2>
      <div class="input">
        <input type="number" name="amount" id="" placeholder="Amount" maxlength="100">
      </div>
    </div>
  </div>
  <script src="/js/effects/loading.js"></script>
  <script src="/js/api/donationBtn.js">
  </script>
</body>

</html>