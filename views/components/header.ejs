<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= title %></title>

  <link rel="icon" type="image/x-icon" href="/assets/icons/logo.ico">
  <link rel="icon" type="image/webp" sizes="16x16" href="/assets/icons/favicon-16x16.webp">
  <link rel="icon" type="image/webp" sizes="32x32" href="/assets/icons/favicon-32x32.webp">

  <link rel="stylesheet" href="/styles/<%= path %>.css">
  <link rel="stylesheet" href="/styles/components/footer.css">
  <link rel="stylesheet" href="/styles/components/components.css">
  <link rel="stylesheet" href="/styles/components/effects/loader.css">
  <link rel="stylesheet" href="/styles/__global_variables__.css">

  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

  <% if (typeof imports !== "undefined") { %>
    <%- imports %>
  <% } %>

  <script src="/js/<%= path %>.js" type="module" defer></script>

  <meta property="description" content="<%= description %>">
  <meta property="keywords" content="Hexion, programming, coding, tools, free">
  <meta property="author" content="EluminusCo">
  <meta property="robots" content="index, follow">

  <meta property="og:title" content="Hexion • <%= title %>">
  <meta property="og:description" content="<%= description %>">

  <meta property="og:image" content="/assets/icons/banner.webp">
  <meta property="og:url" content="<%= url %>">
  <meta property="og:type" content="website">

  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:title" content="Hexion • <%= title %>">
  <meta property="twitter:description" content="<%= description %>">
  <meta property="twitter:image" content="/assets/icons/banner.webp">
  <style id="navbarLink">
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      width: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-gutter: stable;
      font-family: 'Inter', Sans-Serif;
      box-sizing: border-box;
      background-color: var(--bg-dark);
    }

    body {
    }

    .container {
      position: relative;
      width: 100%;
      margin: 0 auto;
      min-height: 100vh;
    }
    
    main {
      padding: 0 1em;
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex: 1;
      min-width: 0;
    }

    .ad-container {
      position: relative;
      height: 50px;
      flex: 1;
      background: transparent;
      border-radius: 5px;
      padding: 10px;
      margin: 1em 0;
      border: 1px solid var(--border-muted);
      box-shadow: 0 4px 1px var(--shadow);
    }

    .ad-container p {
      color: var(--text);
      text-align: center;
    }
    
    .copy-alert-container {
      position: fixed;
      display: flex;
      justify-self: center;
      justify-content: center;
      align-items: center;
      bottom: -110vh;
      visibility: hidden;
      margin-bottom: 1em;
      gap: .3em;
      padding: .2em .5em;
      color: var(--bg);
      font-size: .85em;
      z-index: 9;
      border-radius: 2em;
      background-color: var(--text);
      transition: all .5s;
    }
    
    .copy-alert-container.active {
      bottom: 0;
      visibility: visible;
    }
    
    .page-header {
      color: white;
      text-align: center;
      font-size: 1.5em;
      padding: 20px;
      display: flex;
      width: 100%;
      margin-bottom: 1em;
      margin-top: 1em;
      align-items: center;
      justify-content: center;
      gap: .25em;
    }
    
    .page-header p {
      min-width: 0;
      overflow-wrap: break-word;
      word-break: break-word;
    }
    
    .header-tag {
      display: flex;
      gap: 3px;
      align-items: center;
      padding: 2px;
      background-color: white;
      font-size: .6em;
      <% if (typeof header === "undefined" || false) { %>
      color: <%= color %>;
      <% } %>
      border-radius: 3px;
    }
    
    .back-container {
      display: flex;
      padding: .3em 1em .3em 1em;
      width: max-content;
      flex-direction: row;
      color: var(--text);
      background-color: var(--bg);
      border: 1px solid var(--border);
      border-left: none;
      border-top-right-radius: 2em;
      border-bottom-right-radius: 2em;
      font-size: .65em;
      font-weight: bold;
      cursor: pointer;
      align-items: center;
      user-select: none;
      text-decoration: none;
      transition: all .3s;
    }
    
    .back-container i {
      font-size: 1.8em;
    }
    
    .back-container:hover {
      transform: translateX(-6px);
    }
  </style>
  <!-- Ad Scripts -->
</head>

<body>
  <div class="container">
    <div class="loader" id="loader">
      <svg class="circular" viewBox="25 25 50 50">
        <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="3.5" stroke-miterlimit="10"></circle>
      </svg>
    </div>

    <script>
      // Loads the Loading screen when the user loads the page
      function toggleLoader(value) {
        //adds the required classList
        if (value === true) document.getElementById("loader").classList.remove("fade-out");
        if (value === false) document.getElementById("loader").classList.add("fade-out");
      }

      window.onload = toggleLoader(false);
    </script>
    <!-- Copy alert -->
    <div class="copy-alert-container" id="copyAlertContainer">
      <i class="bx bx-clipboard-check"></i>
      <p>Copied to clipboard!</p>
    </div>
    
    <% if (typeof header === "undefined" || false) { %>
    <%- include('navbar') -%>
    <% if (typeof backButton !== "undefined" && backButton) { %>
    <a href="/dashboard" class="back-container"><i class="bx bx-arrow-left-stroke"></i>
      <p>Back to dashboard</p>
    </a>
    <% } %>
    <h1 class="page-header" style="background: linear-gradient(to right, transparent 0%, <%= color %> 15%, <%= color %> 85%, transparent 100%);">
      <i class="<%= icon %>"></i>
      <p><%= title %></p>
      <% if (typeof tag !== "undefined") { %>
      <span class="header-tag"><%= tag %></span>
      <% } %>
    </h1>
    <% } %>
    <main>