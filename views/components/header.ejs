<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= title %></title>

  <link rel="icon" type="image/x-icon" href="/assets/icons/logo.ico">
  <link rel="icon" type="image/webp" sizes="16x16" href="/assets/icons/favicon-16x16.webp">
  <link rel="icon" type="image/webp" sizes="32x32" href="/assets/icons/favicon-32x32.webp">

  <link rel="stylesheet" href="/styles/<%= path %>.css">
  <link rel="stylesheet" href="/styles/components/footer.css">
  <link rel="stylesheet" href="/styles/components/effects/loader.css">
  <link rel="stylesheet" href="/styles/__global_variables__.css">

  <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>
  <link href='https://cdn.boxicons.com/fonts/brands/boxicons-brands.min.css' rel='stylesheet'>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

  <% if (typeof imports !== "undefined") { %>
    <%- imports %>
  <% } %>

  <script src="/js/<%= path %>.js" type="module" defer></script>

  <meta property="description" content=<%= description %>>
  <meta property="keywords" content="Hexion, programming, coding, tools, free">
  <meta property="author" content="EluminusCo">
  <meta property="robots" content="index, follow">

  <meta property="og:title" content="Hexion • <%= title %>">
  <meta property="og:description" content=<%= description %>>

  <meta property="og:image" content="/assets/icons/banner.webp">
  <meta property="og:url" content=<%= url %>>
  <meta property="og:type" content="website">

  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:title" content="Hexion • <%= title %>">
  <meta property="twitter:description" content=<%= description %>>
  <meta property="twitter:image" content="/assets/icons/banner.webp">
  <style id="navbarLink">
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      width: 100%;
      overflow-x: hidden;
      overflow-y: scroll;
      font-family: 'Inter', Sans-Serif;
      box-sizing: border-box;
      background-color: var(--bg-dark);
    }
    
    body {
      padding: 0 1em;
    }

    .container {
      position: relative;
      width: 100%;
      margin: 0 auto;
      min-height: 100vh;
    }
    
    main {
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex: 1;
      min-width: 0;
    }

    .ad-container {
      position: relative;
      height: 50px;
      flex: 1;
      background: transparent;
      border-radius: 5px;
      padding: 10px;
      margin: 1em 0;
      border: 1px solid var(--border-muted);
      box-shadow: 0 4px 1px var(--shadow);
    }

    .ad-container p {
      color: var(--text);
      text-align: center;
    }

    .page-header {
      color: white;
      text-align: center;
      padding: 20px;
      display: flex;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-bottom: 1em;
      margin-top: 1em;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }
    
    /* Custom Scrollbar (support for chromium browsers) */
    @supports selector(::-webkit-scrollbar) {
      *:not(body)::-webkit-scrollbar {
        background: none;
        width: 2vw;
        height: 2vw;
      }
      
      *:not(body)::-webkit-scrollbar-thumb {
        -webkit-border-radius: 2em;
        border-right-width: .2em;
        border-left-width: .2em;
        -webkit-box-shadow: inset 0 0 0 1px var(--bg), inset 0 0 0 4px var(--bg-light);
        border: solid 0 rgb(0 0 0 / 0%);
      }
      
      *:not(body)::-webkit-scrollbar-thumb:horizontal {
        -webkit-border-radius: 2em;
        border-right-width: 0;
        border-left-width: 0;
        border-top-width: .2em;
        border-bottom-width: .2em;
        -webkit-box-shadow: inset 0 0 0 1px var(--bg), inset 0 0 0 4px var(--bg-light);
        border: solid 0 rgb(0 0 0 / 0%);
      }
      
      *:not(body)::-webkit-scrollbar-track {
        background: none;
      }
      
      *:not(body)::-webkit-scrollbar-track-piece {
        margin: .2em 0;
      }
      
      *:not(body)::-webkit-scrollbar-corner {
        background: transparent;
      }
    }
    
    /* Custom Scrollbar (Support for FireFox) */
    @supports(scrollbar-color: auto) {
      html {
        scrollbar-color: var(--bg-light);
        scrollbar-width: 2vw;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="loader" id="loader">
      <svg class="circular" viewBox="25 25 50 50">
        <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="3.5" stroke-miterlimit="10"></circle>
      </svg>
    </div>
      
    <script>
      // Loads the Loading screen when the user loads the page
      function toggleLoader(value) {
        //adds the required classList
        if (value === true) document.getElementById("loader").classList.remove("fade-out");
        if (value === false) document.getElementById("loader").classList.add("fade-out");
      }

      window.onload = toggleLoader(false);
    </script>