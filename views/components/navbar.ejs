<script src="/js/handlers/subMenu.js" defer></script>
<script src="/js/handlers/sideBar.js" defer></script>
<link href="https://fonts.googleapis.com/css2?family=BBH+Sans+Bogle&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles/components/navbar.css">

<div class="background-sidebar" id="backgroundSideBar"></div>
<header class="header-container">
  <nav class="nav-bar">
    <div class="header-name">
      <i class="bx bx-menu-wider" id="sideBarButton"></i>
      <img src="/assets/icons/logo.webp" draggable="false"/>
      <h1>Hexion</h1>
    </div>
    <aside class="side-bar" id="sideBar">
      <ul>
        <li>
          <a href="/dashboard" class="<%= isCurrentPage('/dashboard') ? 'active' : '' %>">
            <i class="bx bx-dashboard-alt"></i>
            Dashboard
          </a>
        </li>
        <li class="sub-menu-button">
          <span class="<%= isCurrentPage('/tools') ? 'active' : '' %>">
            <i class="bx bx-spanner"></i>
            Tools
            <i class="bx bx-chevron-up toggle-button"></i>
          </span>
          <ul class="sub-menu">
            <div>
              <li>
                <a href="/tools/encoder" class="<%= isCurrentPage('/tools/encoder') ? 'active' : '' %>">
                  Encoder
                </a>
              </li>
              <li>
                <a href="/tools/decoder" class="<%= isCurrentPage('/tools/decoder') ? 'active' : '' %>">
                  Decoder
                </a>
              </li>
              <li>
                <a href="/tools/encrypter" class="<%= isCurrentPage('/tools/encrypter') ? 'active' : '' %>">
                  Encrypter
                </a>
              </li>
              <li>
                <a href="/tools/decrypter" class="<%= isCurrentPage('/tools/decrypter') ? 'active' : '' %>">
                  Decrypter
                </a>
              </li>
              <li>
                <a href="/tools/errorDebugger" class="<%= isCurrentPage('/tools/errorDebugger') ? 'active' : '' %>">
                  Error Debugger
                </a>
              </li>
              <li>
                <a href="/tools/gradientGenerator" class="<%= isCurrentPage('/tools/gradientGenerator') ? 'active' : '' %>">
                  Gradient Generator
                </a>
              </li>
              <li>
                <a href="/tools/request" class="<%= isCurrentPage('/tools/request') ? 'active' : '' %>">
                  Request Sender
                </a>
              </li>
              <li>
                <a href="/tools/image" class="<%= isCurrentPage('/tools/image') ? 'active' : '' %>">
                  Image Converter
                </a>
              </li>
              <li>
                <a href="/tools/ascii" class="<%= isCurrentPage('/tools/ascii') ? 'active' : '' %>">
                  Ascii Art Generator
                </a>
              </li>
              <li>
                <a href="/tools/color" class="<%= isCurrentPage('/tools/color') ? 'active' : '' %>">
                  Color Converter
                </a>
              </li>
            </div>
          </ul>
        </li>
        <li>
          <a href="/donation" class="<%= isCurrentPage('/donation') ? 'active' : '' %>">
            <i class='bx bxs-gift'></i>
            Donation
          </a>
        </li>
      </ul>
    </aside>
    <button id="themeSwitcher" class="theme-switcher"><i class="bx bx-desktop"></i></button>
  </nav>
</header>

<div class="alert-container" id="alertContainer">
  <div class="close-btn" id="closeButton">
    <i class="bx bx-x"></i>
  </div>
  <div class="alert-header">
    <i id="alertIcon"></i>
    <h5 class="alert-title" id="alertTitle"></h5>
  </div>
  <p id="alertMessage"></p>
</div>
